<!-- Warning Banner -->
<table
  class="st-Copy st-Width st-Width--mobile"
  border="0"
  cellpadding="0"
  cellspacing="0"
  width="600"
  style="min-width: 600px;"
>
  <tbody>
    <tr>
      <td
        class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="64"
      >
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
      <td style="border: 0; margin: 0; padding: 0;">
        <div
          style="background-color:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif;font-size:14px;line-height:22px;color:#92400e;"
        >{{text}}</div>
      </td>
      <td
        class="st-Spacer st-Spacer--gutter"
        style="border: 0; margin:0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
        width="64"
      >
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
    <tr>
      <td
        class="st-Spacer st-Spacer--stacked"
        colspan="3"
        height="14"
        style="border: 0; margin: 0; padding: 0; font-size: 1px; line-height: 1px; mso-line-height-rule: exactly;"
      >
        <div class="st-Spacer st-Spacer--filler"></div>
      </td>
    </tr>
  </tbody>
</table>
<!-- /Warning Banner -->